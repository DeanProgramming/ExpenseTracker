@model ExpenseTracker.Models.ViewModels.ExpenseDashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Interactive demo";
    ViewData["IsDemoDashboard"] = true;
}

<link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
<partial name="_ExpenseDashboard" />

<script id="dashboard-initial-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model))</script>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.js"></script>
    <script src="~/js/DemoExpenseStore.js" asp-append-version="true"></script>
    <script src="~/js/ExpenseDashboard.js" asp-append-version="true"></script>
    <script src="~/js/DemoExpenseOverview.js" asp-append-version="true"></script>
}
