@model IEnumerable<ExpenseTracker.Models.Expense>
@using System.Globalization
@using System.Text.Json
@{
    ViewData["Title"] = "My expenses";
    ViewData["IsDemoDashboard"] = false;

    // Keep the model and categories supplied by the existing authorized controller.
    // Only display fields are serialized; ownership never comes from the browser.
    var initialData = new
    {
        CurrentMonth = DateTime.UtcNow.ToString("yyyy-MM", CultureInfo.InvariantCulture),
        Expenses = Model.Select(e => new
        {
            e.Id,
            e.Description,
            e.Amount,
            Date = e.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            e.CategoryId,
            CategoryName = e.Category.Name
        }),
        Categories = (object)ViewBag.CategoriesForJS
    };
    var endpoints = new
    {
        Create = Url.Action("Create", "Expenses"),
        Edit = Url.Action("Edit", "Expenses"),
        Delete = Url.Action("Delete", "Expenses"),
        Regenerate = Url.Action("Regenerate", "Expenses")
    };
}

<link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
<partial name="_ExpenseDashboard" />

<div id="dashboard-antiforgery" hidden>@Html.AntiForgeryToken()</div>
<p id="dashboard-login" hidden>
    Your session has ended.
    <a asp-area="Identity" asp-page="/Account/Login"
       asp-route-returnUrl="@Url.Action("Index", "Expenses")">Log in again</a>.
</p>
<!-- Keep default JSON escaping so user descriptions cannot close this element. -->
<script id="dashboard-initial-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(initialData))</script>
<script id="dashboard-endpoints" type="application/json">@Html.Raw(JsonSerializer.Serialize(endpoints))</script>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.js"></script>
    <script src="~/js/ExpenseApiStore.js" asp-append-version="true"></script>
    <script src="~/js/ExpenseDashboard.js" asp-append-version="true"></script>
    <script src="~/js/ExpenseOverview.js" asp-append-version="true"></script>
}
